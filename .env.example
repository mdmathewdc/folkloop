# PostgreSQL (local Docker default; Neon/Supabase SSL is auto-detected from URL)
DATABASE_URL=postgresql://folkloop:folkloop@localhost:5432/folkloop
# DATABASE_SSL=true

# Temporal Server (local Docker default)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=folkloop-villagers
TEMPORAL_UI_URL=http://localhost:8233

# Temporal Cloud (uncomment for production deployment — enables TLS automatically)
# TEMPORAL_ADDRESS=<region>.aws.api.temporal.io:7233
# TEMPORAL_NAMESPACE=<your-namespace>.<account-id>
# TEMPORAL_API_KEY=<your-temporal-cloud-api-key>
# TEMPORAL_UI_URL=https://cloud.temporal.io

# Simulation configuration
# Default: 30000 ms (30 real seconds) = 1 in-game hour
SIMULATION_MS_PER_HOUR=30000
# Number of in-game days before Bob's workflow triggers Continue-As-New
CONTINUE_AS_NEW_AFTER_DAYS=3
